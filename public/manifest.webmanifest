{
  "name": "Coaching Sathi \u2014 Attendance Manager",
  "short_name": "Coaching Sathi",
  "description": "Swipe-to-mark attendance for coaching centres. Swipe left for present, right for absent.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "lang": "en-IN",
  "dir": "ltr",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "categories": [
    "education",
    "productivity"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "shortcuts": [
    {
      "name": "Mark attendance",
      "short_name": "Attendance",
      "description": "Open the swipe deck for today's class",
      "url": "./?go=attendance",
      "icons": [
        {
          "src": "icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Fees and invoices",
      "short_name": "Fees",
      "description": "See who has paid this month and download invoices",
      "url": "./?go=fees",
      "icons": [
        {
          "src": "icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Students",
      "short_name": "Students",
      "description": "Add a student or edit a phone number",
      "url": "./?go=students",
      "icons": [
        {
          "src": "icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Student Hub links",
      "short_name": "Hub",
      "description": "Create or re-share a student's personal login link",
      "url": "./?go=hub",
      "icons": [
        {
          "src": "icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+coachingsathi",
      "url": "./?p=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./?go=restore",
      "launch_type": "single-client",
      "accept": {
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "screenshots/install-attendance.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Attendance deck: batch chips, swipe left for present, right for absent"
    },
    {
      "src": "screenshots/install-marked.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Day fully marked, 7 present and 1 absent, ready to lock"
    },
    {
      "src": "screenshots/install-fees.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Monthly fees, who has paid, and one-tap WhatsApp reminders"
    },
    {
      "src": "screenshots/install-students.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Student list with batch filter, search and WhatsApp actions"
    },
    {
      "src": "screenshots/install-hub.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Student Hub Manager: one magic link per student"
    },
    {
      "src": "screenshots/install-invoice.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Month-end invoice for one student, ready to download"
    }
  ],
  "icons": [
    {
      "src": "icon-192-v15.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-v15.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512-v15.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
