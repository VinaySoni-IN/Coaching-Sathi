{
  "name": "Coaching Sathi — Student Hub",
  "short_name": "Student Hub",
  "description": "Live classes, notes and class alerts shared by your teacher, for your batch only.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "lang": "en-IN",
  "dir": "ltr",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "categories": ["education"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Live class",
      "short_name": "Live",
      "description": "Jump to today's class and the schedule",
      "url": "./?go=live",
      "icons": [
        {
          "src": "../student-icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notes & study materials",
      "short_name": "Notes",
      "description": "Filter the notes your teacher shared for your batch",
      "url": "./?go=notes",
      "icons": [
        {
          "src": "../student-icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Class alerts",
      "short_name": "Alerts",
      "description": "Turn on notifications for this phone",
      "url": "./?go=alerts",
      "icons": [
        {
          "src": "../student-icon-192-v15.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/portal-hub.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Today's class, alerts and the notes shared for your batch"
    }
  ],
  "icons": [
    {
      "src": "../student-icon-192-v15.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../student-icon-512-v15.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../student-icon-maskable-512-v15.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
