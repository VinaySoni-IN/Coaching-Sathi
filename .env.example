# Supabase Auth, manual cloud backups, and the Student Hub. Both values are PUBLIC:
# the anon key is meant to ship in the bundle. Never put the service_role key here.
# Optional: student-hub/config.json already contains the project's public defaults so GitHub
# Pages builds work without environment variables. Set these only to point both apps at another project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
